{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brasa-api-staging",
  "account_id": "4efc762f8d77c5bca6120096d4df8dd1",
  "main": "dist/worker.js",
  "assets": {"directory":"./web/public","binding":"AUTH_ASSETS","run_worker_first":true},
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "limits": {"cpu_ms": 1000},
  "secrets": {"required": ["BETTER_AUTH_SECRET"]},
  "vars": {
    "APP_ENV": "staging",
    "AUTH_MODE": "better_auth",
    "BETTER_AUTH_URL": "https://brasa-api-staging.acessloop.workers.dev",
    "LOG_REQUESTS": "true"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "brasa-staging",
    "database_id": "9b3299f9-1c43-417e-9b02-28842b8e05a5",
    "migrations_dir": "migrations"
  }],
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
