; Brasa · Liga de los Faroles — prototipo original
config_version=5

[application]
config/name="Brasa · Liga de los Faroles"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="BrasaLiga"

[display]
window/size/viewport_width=1360
window/size/viewport_height=880
window/size/window_width_override=1224
window/size/window_height_override=792
window/stretch/mode="disabled"
window/size/resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.077, 0.085, 1)

[audio]
driver/enable_input=false
